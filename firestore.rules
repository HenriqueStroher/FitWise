rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de exercícios: leitura livre, sem login (como sempre foi).
    // Escrita só pelo console / Admin SDK, que ignoram estas regras.
    match /exercicios/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Dados de cada usuário (perfil, plano dos dias e registros semanais):
    // só o próprio dono lê e escreve.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{documento=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
